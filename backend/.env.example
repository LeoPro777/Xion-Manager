# ==============================================================================
# XION-MANAGER - CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================

PROJECT_NAME="Xion-Manager"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"

# Seguridad y Criptografía
SECRET_KEY="clave_secreta_jwt_de_alta_entropia_cambiar_en_produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Base de Datos (PostgreSQL en Producción / SQLite en Desarrollo Local)
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH="xion_manager_dev.db"
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xion_admin
POSTGRES_PASSWORD=xion_seguro_db_pass
POSTGRES_DB=xion_manager_db

# ==============================================================================
# ALMACENAMIENTO DE ARCHIVOS E IMÁGENES - CLOUDFLARE R2 (S3-COMPATIBLE)
# ==============================================================================
STORAGE_BACKEND=r2

# ID de cuenta de Cloudflare (obtenido en el dashboard de Cloudflare R2)
R2_ACCOUNT_ID="your_cloudflare_account_id_here"

# Endpoint S3 de Cloudflare R2 (https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL="https://your_cloudflare_account_id_here.r2.cloudflarestorage.com"

# Credenciales de API Token de Cloudflare R2 con permisos Object Read & Write
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# Nombre del bucket configurado en Cloudflare R2
R2_BUCKET_NAME="xion-media"

# Dominio público personalizado o CDN configurado para el bucket (Archivos públicos)
R2_PUBLIC_DOMAIN_URL="https://media.xion.com"

# Expiración en segundos de URLs prefirmadas para archivos privados (por defecto 15 min)
R2_PRESIGNED_URL_EXPIRES_IN=900

# ==============================================================================
# SERVICIOS EXTERNOS Y GOBERNANZA
# ==============================================================================
GOOGLE_MAPS_API_KEY="AIzaSy_mock_google_maps_key"
XION_PAY_WEBHOOK_SECRET="whsec_firma_xion_pay_segura"
GRACE_PERIOD_DAYS=3
