# ==============================================================================
# XION-MANAGER - CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================

PROJECT_NAME="Xion-Manager"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"

# Seguridad y Criptografía
SECRET_KEY="clave_secreta_jwt_de_alta_entropia_cambiar_en_produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Render Port (Asignado automáticamente por Render en producción)
PORT=8000

# Base de Datos (Supabase PostgreSQL / Pooler o PostgreSQL / SQLite en Desarrollo)
# En Render / Producción: Pega directamente la URL de conexión de Supabase (Pooler o Directa):
# Ejemplo Supabase Pooler (Transaction Mode 6543 o Session Mode 5432):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
# Ejemplo Supabase Direct Connection:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DATABASE_URL=""

# Parámetros desglosados (Alternativa si no usas DATABASE_URL directa):
POSTGRES_SERVER=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_db_password
POSTGRES_DB=postgres
POSTGRES_SSL=True

# SQLite local fallback (solo para desarrollo local sin conexión)
USE_SQLITE_FALLBACK=False
SQLITE_DB_PATH="xion_manager_dev.db"

# Supabase API (Opcional si usas Supabase PostgREST / Storage / Auth en frontend)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-public-key"


# ==============================================================================
# ALMACENAMIENTO DE ARCHIVOS E IMÁGENES - CLOUDFLARE R2 (S3-COMPATIBLE)
# ==============================================================================
STORAGE_BACKEND=r2

# ID de cuenta de Cloudflare (obtenido en el dashboard de Cloudflare R2)
R2_ACCOUNT_ID="your_cloudflare_account_id_here"

# Endpoint S3 de Cloudflare R2 (https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL="https://your_cloudflare_account_id_here.r2.cloudflarestorage.com"

# Credenciales de API Token de Cloudflare R2 con permisos Object Read & Write
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# Nombre del bucket configurado en Cloudflare R2
R2_BUCKET_NAME="xion-media"

# Dominio público personalizado o CDN configurado para el bucket (Archivos públicos)
R2_PUBLIC_DOMAIN_URL="https://media.xion.com"

# Expiración en segundos de URLs prefirmadas para archivos privados (por defecto 15 min)
R2_PRESIGNED_URL_EXPIRES_IN=900

# ==============================================================================
# PROVEEDOR DE MAPAS Y GEOLOCALIZACIÓN (STRATEGY / ADAPTER PATTERN)
# ==============================================================================
# Proveedor activo: 'osm' (OpenStreetMap/Photon/Nominatim) o 'google' (Google Maps Platform)
MAP_PROVIDER="osm"
VITE_MAP_PROVIDER="osm"

# Claves de Google Maps Platform (Requeridas únicamente si MAP_PROVIDER / VITE_MAP_PROVIDER='google')
GOOGLE_MAPS_API_KEY="AIzaSy_mock_google_maps_key"
VITE_GOOGLE_MAPS_API_KEY=""

# ==============================================================================
# SERVICIOS EXTERNOS Y GOBERNANZA
# ==============================================================================
XION_PAY_WEBHOOK_SECRET="whsec_firma_xion_pay_segura"
GRACE_PERIOD_DAYS=3

